    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.8",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8"
  }
}
